{
  "name": "ai-frontier-notes",
  "version": "1.0.0",
  "private": true,
  "description": "AI 前沿评论：偏思考与深度的 AI 专业站点，GitHub Actions 自动更新，部署于 GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
