    "update:dry": "node scripts/update.mjs --dry",
    "collect": "node scripts/update.mjs --collect-only"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "marked": "^15.0.0",
    "marked-highlight": "^2.2.1",
    "marked-katex-extension": "^5.1.4"
  }
